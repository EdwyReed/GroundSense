{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:groundsense:contracts:1.1",
  "title": "GroundSense v1.1 first-slice wire contracts; not a scientific readiness claim",
  "$ref": "#/$defs/ScientificAssessment",
  "$defs": {
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "reason": {"enum": ["MODEL_NOT_VALIDATED", "INSUFFICIENT_FIELD_EVIDENCE", "ROAD_STRUCTURE_UNKNOWN", "VEHICLE_ENVELOPE_UNSUPPORTED", "FORECAST_HORIZON_EXCEEDED", "ENSEMBLE_INSUFFICIENT", "FREEZE_THAW_AMBIGUOUS", "CRITICAL_SOURCE_MISSING", "SOURCE_STALE", "OUT_OF_DOMAIN", "ACCESS_CONSTRAINT_UNRESOLVED", "REQUIRES_REPAIR", "MODEL_WITHDRAWN", "ASSET_ACCESS_UNVERIFIED", "HYDRAULIC_CLOSURE_UNAVAILABLE", "STATE_INITIALIZATION_UNAVAILABLE", "MODEL_NUMERICAL_FAILURE"]},
    "AnalysisAcceptance": {"type": "object", "additionalProperties": false, "required": ["analysis_id", "job_id", "accepted_at", "idempotency_scope"], "properties": {"analysis_id": {"type": "string", "minLength": 1}, "job_id": {"type": "string", "minLength": 1}, "accepted_at": {"$ref": "#/$defs/utc"}, "idempotency_scope": {"type": "string", "minLength": 1}}},
    "JobStatus": {"type": "object", "additionalProperties": false, "required": ["job_id", "status", "updated_at"], "properties": {"job_id": {"type": "string", "minLength": 1}, "status": {"enum": ["accepted", "running", "completed", "failed", "cancelled"]}, "updated_at": {"$ref": "#/$defs/utc"}, "result_ref": {"$ref": "#/$defs/ref"}}},
    "ServingEnvelope": {"type": "object", "additionalProperties": false, "required": ["served_at", "policy_revision", "authz_revision", "publication_manifest_digest", "payload"], "properties": {"served_at": {"$ref": "#/$defs/utc"}, "policy_revision": {"type": "string", "minLength": 1}, "authz_revision": {"type": "string", "minLength": 1}, "publication_manifest_digest": {"$ref": "#/$defs/digest"}, "payload": {"type": "object"}}},
    "ManifestView": {"type": "object", "additionalProperties": false, "required": ["manifest_digest", "authorized_artifacts", "policy_revision", "authz_revision"], "properties": {"manifest_digest": {"$ref": "#/$defs/digest"}, "authorized_artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["artifact_ref"], "properties": {"artifact_ref": {"type": "string", "pattern": "^artifact:[A-Za-z0-9._:-]+$"}, "media_type": {"type": "string"}}}}, "policy_revision": {"type": "string"}, "authz_revision": {"type": "string"}}},
    "ResultManifest": {"type": "object", "additionalProperties": false, "required": ["manifest_version", "release_id", "run_id", "canonicalization", "digest_algorithm", "outputs"], "properties": {"manifest_version": {"const": "1.1"}, "release_id": {"type": "string"}, "run_id": {"type": "string"}, "canonicalization": {"const": "RFC8785-JCS"}, "digest_algorithm": {"const": "SHA-256-UTF8"}, "outputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["artifact_ref", "digest"], "properties": {"artifact_ref": {"type": "string", "pattern": "^artifact:[A-Za-z0-9._:-]+$"}, "digest": {"$ref": "#/$defs/digest"}}}}}},
    "Environment": {"type": "object", "additionalProperties": false, "required": ["status", "condition", "reason_codes", "condition_policy_ref", "physical_series_ref"], "properties": {"status": {"enum": ["available", "unknown"]}, "condition": {"type": ["string", "null"], "enum": ["less_adverse", "adverse", "severe", null]}, "reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}}, "condition_policy_ref": {"$ref": "#/$defs/ref"}, "physical_series_ref": {"$ref": "#/$defs/ref"}}},
    "Mobility": {"type": "object", "additionalProperties": false, "required": ["kind", "risk", "probability_bounds", "outcome", "estimand", "operation_ref", "configuration_aggregation", "traction_loss", "pass_policy_ref", "vehicle_envelope_ref", "calibration_report_ref", "reason_codes"], "properties": {"kind": {"enum": ["calibrated_probability", "probability_bounds", "unavailable"]}, "risk": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "probability_bounds": {"type": ["object", "null"], "additionalProperties": false, "required": ["lower", "upper"], "properties": {"lower": {"type": "number", "minimum": 0, "maximum": 1}, "upper": {"type": "number", "minimum": 0, "maximum": 1}}}, "outcome": {"type": ["string", "null"], "enum": ["immobilization", "rut_depth_exceeded_after_n_passes", "structural_damage", "traction_loss", null]}, "estimand": {"type": ["string", "null"], "enum": ["operation_time_risk", "day_category", "day_operation_risk", null]}, "operation_ref": {"$ref": "#/$defs/ref"}, "configuration_aggregation": {"type": ["object", "null"], "additionalProperties": false, "properties": {"kind": {"enum": ["known_weighted_mixture", "robust_all_configurations", "bounds"]}, "policy_ref": {"$ref": "#/$defs/ref"}}}, "traction_loss": {"type": ["string", "null"], "enum": ["assessed", "not_assessed", "unknown", null]}, "pass_policy_ref": {"$ref": "#/$defs/ref"}, "vehicle_envelope_ref": {"$ref": "#/$defs/ref"}, "calibration_report_ref": {"$ref": "#/$defs/ref"}, "reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}}}},
    "RecoveryDistribution": {"type": "object", "additionalProperties": false, "required": ["kind", "status", "distribution_kind", "reference_time", "horizon_end", "event_time_convention", "event_definition_version", "probability_by_horizon", "cdf", "cdf_bounds", "bounds_by_horizon", "quantiles", "known_weight_mass", "lost_weight_mass", "ensemble_policy_ref", "missing_mass_reasons", "calibration_status", "recovery_calibration_report_ref", "vehicle_envelope_ref", "matching_report_ref", "reason_codes"], "properties": {"kind": {"enum": ["environmental_recovery", "vehicle_condition_recovery"]}, "status": {"enum": ["forecast_distribution", "already_recovered", "right_censored", "unknown", "unsupported"]}, "distribution_kind": {"enum": ["exact_scenario_distribution", "partially_identified", "unavailable"]}, "reference_time": {"$ref": "#/$defs/utc"}, "horizon_end": {"$ref": "#/$defs/utc"}, "event_time_convention": {"const": "confirmation_end"}, "confirmation_basis": {"enum": ["model_history", "field_protocol", null]}, "confirmation_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "event_definition_version": {"type": "string", "minLength": 1}, "probability_by_horizon": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "cdf": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["time", "probability"], "properties": {"time": {"$ref": "#/$defs/utc"}, "probability": {"type": "number", "minimum": 0, "maximum": 1}}}}, "cdf_bounds": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["time", "lower", "upper"], "properties": {"time": {"$ref": "#/$defs/utc"}, "lower": {"type": "number", "minimum": 0, "maximum": 1}, "upper": {"type": "number", "minimum": 0, "maximum": 1}}}}, "bounds_by_horizon": {"type": ["object", "null"], "additionalProperties": false, "required": ["lower", "upper"], "properties": {"lower": {"type": "number", "minimum": 0, "maximum": 1}, "upper": {"type": "number", "minimum": 0, "maximum": 1}}}, "quantiles": {"type": "object", "additionalProperties": false, "required": ["p10", "p50", "p90"], "properties": {"p10": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"}, "p50": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"}, "p90": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"}}}, "known_weight_mass": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "lost_weight_mass": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "ensemble_policy_ref": {"$ref": "#/$defs/ref"}, "missing_mass_reasons": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}}, "calibration_status": {"enum": ["not_calibrated", "calibrated"]}, "recovery_calibration_report_ref": {"$ref": "#/$defs/ref"}, "vehicle_envelope_ref": {"$ref": "#/$defs/ref"}, "matching_report_ref": {"$ref": "#/$defs/ref"}, "reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reason"}}}},
    "SourceSupport": {"type": "object", "additionalProperties": false, "required": ["quantity", "source_ref", "transform_ref", "geometry_ref", "depth_ref", "estimate_kind", "temporal_interval"], "properties": {"quantity": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}, "transform_ref": {"$ref": "#/$defs/ref"}, "geometry_ref": {"$ref": "#/$defs/ref"}, "depth_ref": {"$ref": "#/$defs/ref"}, "estimate_kind": {"enum": ["observation", "forecast", "static_property", "model_derived"]}, "temporal_interval": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"$ref": "#/$defs/utc"}, "end": {"$ref": "#/$defs/utc"}}}}},
    "ScientificAssessment": {"type": "object", "additionalProperties": false, "required": ["contract_version", "synthetic", "production_mode", "context", "segment_id", "assessment_level", "environmental_condition", "mobility", "recovery", "source_supports", "provenance"], "properties": {"contract_version": {"const": "1.1"}, "synthetic": {"type": "boolean"}, "production_mode": {"type": "boolean"}, "context": {"type": "object", "additionalProperties": false, "required": ["assessment_date", "gross_mass_t", "timezone", "assessment_mode", "computed_at", "forecast_issue_time", "knowledge_cutoff", "local_day_utc_interval", "day_aggregation_policy"], "properties": {"assessment_date": {"type": "string", "format": "date"}, "gross_mass_t": {"type": "number", "exclusiveMinimum": 0}, "timezone": {"type": "string", "minLength": 1}, "assessment_mode": {"enum": ["reconstruction", "forecast", "climatology"]}, "computed_at": {"$ref": "#/$defs/utc"}, "forecast_issue_time": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"}, "knowledge_cutoff": {"$ref": "#/$defs/utc"}, "local_day_utc_interval": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"$ref": "#/$defs/utc"}, "end": {"$ref": "#/$defs/utc"}}}, "day_aggregation_policy": {"enum": ["required_support_unknown_dominates_worst_scenario_v1", "most_adverse_applicable_state"]}}}, "segment_id": {"type": "string", "minLength": 1}, "assessment_level": {"enum": ["screening", "validated_domain"]}, "environmental_condition": {"$ref": "#/$defs/Environment"}, "mobility": {"$ref": "#/$defs/Mobility"}, "recovery": {"$ref": "#/$defs/RecoveryDistribution"}, "source_supports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SourceSupport"}}, "provenance": {"type": "object", "additionalProperties": false, "required": ["release_id", "run_id", "input_digest", "model_version"], "properties": {"release_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "input_digest": {"$ref": "#/$defs/digest"}, "model_version": {"type": "string", "minLength": 1}}}}}
  }
}
